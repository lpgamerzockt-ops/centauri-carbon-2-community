+#ifndef TIMELAPSE_BIT_RATE
+#define TIMELAPSE_BIT_RATE 4000000
+#endif
+#ifndef TIMELAPSE_X264_PRESET
+#define TIMELAPSE_X264_PRESET "medium"
+#endif
+#ifndef TIMELAPSE_X264_TUNE
+#define TIMELAPSE_X264_TUNE "stillimage"
+#endif
+#ifndef TIMELAPSE_X264_PROFILE
+#define TIMELAPSE_X264_PROFILE "main"
+#endif
+#ifndef TIMELAPSE_X264_LEVEL
+#define TIMELAPSE_X264_LEVEL "3.1"
+#endif
+#ifndef TIMELAPSE_CRF
+#define TIMELAPSE_CRF 20
+#endif
+#ifndef TIMELAPSE_CRF_ENABLED
+#define TIMELAPSE_CRF_ENABLED 1
+#endif
+
+#ifndef TIMELAPSE_PIC_MAX_SIZE
+#define TIMELAPSE_PIC_MAX_SIZE (300 * 1024)
+#endif
+#ifndef TIMELAPSE_KEEP_SOURCE_JPEGS
+#define TIMELAPSE_KEEP_SOURCE_JPEGS 0
+#endif
+
+/* Storage — must pass timelapse_path_ok() before use at runtime */
+#ifndef TIMELAPSE_PICTURE_DIR
+#define TIMELAPSE_PICTURE_DIR "/opt/usr/picture/"
+#endif
+#ifndef TIMELAPSE_VIDEO_DIR
+#define TIMELAPSE_VIDEO_DIR "/opt/usr/video/"
+#endif
+#ifndef TIMELAPSE_TEMP_LINK
+#define TIMELAPSE_TEMP_LINK "/tmp/pic_link"
+#endif
+
